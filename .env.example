# Public browser configuration (safe to expose)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_APP_URL=

# Server-only Supabase configuration. Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Phone OTP. Development OTPs require both flags and can never run in production.
OTP_PROVIDER=
OTP_PEPPER=
BRICXLEY_ENABLE_DEV_OTP=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Transactional email (server-only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
